# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*Untitled*

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test, lint and coverage caches
.nox/
.tox/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
*.log

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# Environments (.env holds local settings such as DEFORESTATION_ALERTS_DATA_DIR)
.env
.venv
env/
venv/

# Editors and type checkers
.vscode/sftp.json
.vscode/settings.json
.mypy_cache/

# Local outputs
outputs/
CLAUDE.md

# Local Claude Code session data and AI working docs (plans, specs)
.claude/
docs/superpowers/

# leaflet-multiview JS packages (js/leaflet-multiview, js/app): node_modules is
# installed from the committed package-lock.json files (no trailing slash, so a
# symlinked node_modules is ignored too); the built bundle in gui/widget/static
# is committed.
js/**/node_modules
